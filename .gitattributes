# Keep Unity text assets and package metadata normalized.
* text=auto

*.asmdef text eol=lf
*.asset text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.controller text eol=lf
*.cs text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
*.json text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.md text eol=lf
*.prefab text eol=lf
*.shader text eol=lf
*.unity text eol=lf

# Binary assets
*.exr binary
*.fbx binary
*.gif binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.mp4 binary
*.pdf binary
*.png binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.ttf binary
*.wav binary
